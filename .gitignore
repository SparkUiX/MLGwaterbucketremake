# ========== 系统级文件 ==========
.DS_Store
Thumbs.db

# ========== Java & 编译器 ==========
*.class
*.jar
*.war
*.ear

# ========== Gradle ==========
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.gradle-cache/
**/build/

# ========== IDE ==========
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code
.vscode/
*.code-workspace

# ========== OS 缓存文件 ==========
*.swp
*.swo
*~

# ========== 日志文件 ==========
*.log

# ========== Minecraft Launcher 测试生成文件（可选） ==========
run/
logs/
crash-reports/

# ========== 本地环境配置文件（可选） ==========
local.properties
config/
*.cfg

# ========== 只保留源码 & 必需资源 ==========
# 明确保留源代码和资源
!src/main/java/**
!src/main/resources/**
!build.gradle
!settings.gradle
!gradlew
!gradlew.bat
!gradle.properties
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ========== Kotlin (如果使用) ==========
*.kotlin_module

# ========== 加密或不应入库的秘钥文件 ==========
*.keystore
*.pem
*.jks
*.p12

# ========== 其他不需要提交的临时文件 ==========
*.tmp
*.bak
*.old
